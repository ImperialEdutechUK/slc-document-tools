# Database
# Local development can omit DATABASE_URL to use SQLite automatically.
# Railway: set DATABASE_URL to the Postgres service reference.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Frontend origins, comma-separated
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Local storage fallback
STORAGE_DIR=/tmp/slc-document-tools

# Railway bucket / S3-compatible object storage
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Magnific / Freepik stock-linked image retrieval
MAGNIFIC_API_KEY=
MAGNIFIC_RESOURCE_API_BASE=https://api.magnific.com/v1/resources
MAGNIFIC_API_HEADER=x-magnific-api-key
MAX_REMOTE_IMAGE_BYTES=26214400

# Optional Freepik/Magnific account fallback (used only after API failure)
# Keep these in Railway Variables / local .env only. Never commit real credentials.
FREEPIK_ACCOUNT_FALLBACK=false
# Backwards-compatible single account. If ACCOUNT_1 is absent, this is tried first.
FREEPIK_ACCOUNT_EMAIL=
FREEPIK_ACCOUNT_PASSWORD=

# Preferred multi-account configuration. Add only as many as you need.
FREEPIK_ACCOUNT_1_EMAIL=
FREEPIK_ACCOUNT_1_PASSWORD=
FREEPIK_ACCOUNT_2_EMAIL=
FREEPIK_ACCOUNT_2_PASSWORD=
FREEPIK_ACCOUNT_3_EMAIL=
FREEPIK_ACCOUNT_3_PASSWORD=
FREEPIK_LOGIN_URL=https://www.magnific.com/log-in?client_id=magnific&lang=en
FREEPIK_BROWSER_TIMEOUT_MS=30000
PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# Optional selector overrides if the website UI changes:
# FREEPIK_EMAIL_SELECTOR=input[type="email"]
# FREEPIK_PASSWORD_SELECTOR=input[type="password"]
# FREEPIK_SUBMIT_SELECTOR=button[type="submit"]
# FREEPIK_DOWNLOAD_SELECTOR=
