# Database
# Local development can omit DATABASE_URL to use SQLite automatically.
# Railway: set DATABASE_URL to the Postgres service reference.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Frontend origins, comma-separated
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Local storage fallback
STORAGE_DIR=/tmp/slc-document-tools

# Railway bucket / S3-compatible object storage
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Magnific / Freepik stock-linked image retrieval
MAGNIFIC_API_KEY=
# Alternative for an existing Freepik-issued key. Either this or MAGNIFIC_API_KEY
# enables the licensed Freepik stock fallback (AI image generation is disabled in Find & Add Images).
FREEPIK_API_KEY=
MAGNIFIC_RESOURCE_API_BASE=https://api.magnific.com/v1/resources
MAGNIFIC_API_HEADER=x-magnific-api-key
MAX_REMOTE_IMAGE_BYTES=26214400

# Optional Freepik/Magnific account fallback (used only after API failure)
# Keep these in Railway Variables / local .env only. Never commit real credentials.
FREEPIK_ACCOUNT_FALLBACK=false
# Backwards-compatible single account. If ACCOUNT_1 is absent, this is tried first.
FREEPIK_ACCOUNT_EMAIL=
FREEPIK_ACCOUNT_PASSWORD=

# Preferred multi-account configuration. Add only as many as you need.
FREEPIK_ACCOUNT_1_EMAIL=
FREEPIK_ACCOUNT_1_PASSWORD=
FREEPIK_ACCOUNT_2_EMAIL=
FREEPIK_ACCOUNT_2_PASSWORD=
FREEPIK_ACCOUNT_3_EMAIL=
FREEPIK_ACCOUNT_3_PASSWORD=
FREEPIK_LOGIN_URL=https://www.magnific.com/login
FREEPIK_BROWSER_TIMEOUT_MS=45000
PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# Optional selector overrides if the website UI changes:
# FREEPIK_EMAIL_SELECTOR=input[type="email"]
# FREEPIK_PASSWORD_SELECTOR=input[type="password"]
# FREEPIK_SUBMIT_SELECTOR=button[type="submit"]
# FREEPIK_DOWNLOAD_SELECTOR=

# Optional: preferred Freepik/Magnific browser-session fallback.
# Capture locally with: python scripts/capture_freepik_session.py
# Then paste the printed base64 value into Railway. Treat it like a password.
# FREEPIK_ACCOUNT_1_STORAGE_STATE_B64=
# FREEPIK_ACCOUNT_2_STORAGE_STATE_B64=

# NEW: Find & Add Images image provider options
# Guide-only mode is usable without any API key. Keep all keys server-side.
# Stock photos: Pexels free search API, optionally Freepik licensed photos.
PEXELS_API_KEY=
# Freepik images (uses FREEPIK_API_KEY or MAGNIFIC_API_KEY above):
# Older Freepik-issued key: https://api.freepik.com/v1 + x-freepik-api-key
# New Magnific key:      https://api.magnific.com/v1 + x-magnific-api-key
# Only override these when your account requires a specific endpoint.
FREEPIK_API_BASE=
FREEPIK_API_HEADER=
# Legacy Freepik text-to-image integration (not used by Find & Add Images).
FREEPIK_IMAGE_MODEL=flux-2-pro
# Legacy generation cap: Find & Add Images deliberately makes zero AI generation calls.
COURSE_IMAGE_MAX_GENERATIONS=8
# Optional OpenRouter text-only scene planning (not an image-generation API).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional direct OpenAI image generation fallback (not an OpenRouter key).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# 2026-11-03 v28: Course-contextual free-photo search and reusable photo library.
# Provide exact Course / Module Title in the Find & Add Images UI for best matches.
# Preview candidates are never pre-approved. No additional key needed for v28.
# Provide backend secrets in Railway Variables (never expose them in NEXT_PUBLIC_*).
PIXABAY_API_KEY=
# Openverse public-domain CC0/PDM Wikimedia photos (no API key required).
OPENVERSE_ENABLED=true
# v26: Freepik access is OFF by default even when image_source=mixed.
# The user must tick "Allow paid Freepik stock fallback". Optional backend
# limits below are additional safeguards when users explicitly enable it.
# Count attempted Freepik *searches*, including unsuccessful lookups.
COURSE_IMAGE_MAX_FREEPIK_ATTEMPTS=1
# Count successful Freepik stock image selections separately.
COURSE_IMAGE_MAX_FREEPIK_DOWNLOADS=1
# Avoid bulk image retrieval from public libraries and contain cost.
COURSE_IMAGE_MAX_PREVIEW_IMAGES=16
# Total successful photos permitted across all resumable ZIP search batches.
COURSE_IMAGE_MAX_TOTAL_PREVIEW_IMAGES=80
# Successful free replacements permitted across a full review.
COURSE_IMAGE_MAX_FREE_REPLACEMENTS=24
# Request count and elapsed-time budgets for large DOCX/ZIP previews.
COURSE_IMAGE_MAX_STOCK_LOOKUPS=32
COURSE_IMAGE_MAX_SEARCH_SECONDS=75
# For persistent photo reuse across Railway redeployments, configure S3_* above.

# 2026-11-05 v30: conservative subject-aware photograph matching.
# Strict is default and does not need a paid API. Users may select Balanced.
# Course matches are checked against photo text descriptions, not the pixels,
# unless the user explicitly enables AI vision verification in the UI.
# Visual verification uses OPENROUTER_API_KEY above and a vision-capable model.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Limit optional paid image-verification calls per resumed search batch.
COURSE_IMAGE_MAX_VISION_CHECKS=32
